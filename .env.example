# Copie para .env.local e ajuste. NUNCA coloque segredos em variáveis que começam com NEXT_PUBLIC_
# (elas vão para o navegador). O .env.local fica fora do Git.

# Endereço público do site, sem barra no final (metadados, Open Graph e sitemap).
# Na Vercel, se não for definido, usa automaticamente o domínio de produção do projeto.
SITE_URL=https://santuariofatimasaojoaodeus.vercel.app

# Banco de dados do painel de controle (SECRETO). Sem ela: no computador (npm run dev) usa um banco
# embutido na pasta .dados; no site no ar, usa os dados de src/mocks e o painel fica desligado.
# Ver docs/ARQUITETURA.md, seção 6.
# DATABASE_URL=postgresql://usuario:senha@host/santuario?sslmode=require

# Armazenamento das fotos enviadas pelo painel (SECRETO). Sem ela, as fotos ficam em .dados/arquivos.
# BLOB_READ_WRITE_TOKEN=

# 1 = usar o banco embutido (.dados) mesmo fora do "npm run dev"; 0 = desligar o banco no "npm run dev".
# BANCO_LOCAL=
